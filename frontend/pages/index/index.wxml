
<view class="page">
  <!-- 顶部导航栏（替换你原来的顶部标题） -->
  <view class="navbar">
    <text class="title">今日值日任务</text>
    <view class="notification-bell" bindtap="goNotifications">
      🔔
      <text wx:if="{{unreadCount > 0}}" class="badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </view>

  
<view class="container" wx:if="{{!loading}}">
  <!-- 查看任务 -->
  <view wx:if="{{hasTask}}">
    <!-- 进入任务界面 -->
    <view class="card">
      <view class="label">值日地点</view>
      <view class="value">{{location}}</view>
    </view>

    <view class="card">
      <view class="label">时间段</view>
      <view class="value">{{timeRange}}</view>
    </view>

    <view class="card">
      <view class="label">评价状态</view>
      <view class="value">{{status}}</view>
    </view>

    <view class="card">
      <view class="label">打卡状态</view>
      <view class="value">{{isCheckedIn ? '已打卡':'未打卡'}}</view>
    </view>

    <!-- ===== 第一步：展示任务信息 + 开始拍照按钮（未打卡且摄像头未打开时显示） ===== -->
<view wx:if="{{!isCheckedIn && !showCamera}}">
  <button class="my_button" type="primary" bindtap="startCamera">
    📸 开始拍照打卡
  </button>
</view>

<!-- ===== 第二步：摄像头和拍照按钮（showCamera 为 true 时显示） ===== -->
<view wx:if="{{showCamera}}">
  <camera 
    id="myCamera" 
    device-position="back" 
    flash="off" 
    binderror="cameraError" 
    style="width: 100%; height: 400px;">
  </camera>

  <button class="my_button" type="primary" bindtap="take_Photo_CheckIn">
    点击拍照
  </button>

  <!-- 加一个取消按钮，让用户可以关闭摄像头 -->
  <button class="my_button" type="default" bindtap="cancelCamera">
    取消
  </button>
</view>
    <!-- 水印 Canvas -->
    <canvas
      type="2d"
      id="watermarkCanvas" 
      style="width: 375px; height: 375px; position: fixed; top: -999px; left: -9999px;">
    </canvas>

  </view>
  <!-- 还有没有任务的可能 -->
  <view wx:if="{{!hasTask}}">暂无任务</view>

</view>
<!-- 没有加载进来 -->
<view wx:if="{{loading}}">加载中...</view>


</view>