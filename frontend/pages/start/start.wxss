/* pages/start/start.wxss */
/* container: 容器负责居中并留出呼吸感 */
.container {
  display: flex;
  flex-direction: column;
  justify-content: center; /* 垂直居中 */
  align-items: center;     /* 水平居中 */
  height: 100vh;           /* 占满全屏高度 */
  padding: 40rpx;          /* 左右留白 */
  box-sizing: border-box;
  background-color: #f6f7f9; /* 淡淡的背景灰，突出按钮 */
}

/* my_button: 按钮的基础通用样式 */
.my_button {
  width: 80%;              /* 按钮宽度占屏幕80% */
  height: 96rpx;           /* 按钮高度 */
  line-height: 96rpx;      /* 文字垂直居中 */
  margin: 20rpx 0;         /* 上下间距，区分两个按钮 */
  border-radius: 48rpx;    /* 大圆角，更现代 */
  font-size: 32rpx;        /* 字体大小 */
  font-weight: bold;       /* 加粗字体 */
  text-align: center;
  
  /* 阴影效果：增加立体感 (兼容性较好) */
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  
  /* 过渡动画：让点击变色更丝滑 */
  transition: all 0.2s ease; 
  -webkit-transition: all 0.2s ease;
}

/* 学生登录入口 - 特定颜色 (蓝色系) */
/* 注意：这里使用了属性选择器来区分不同文字的按钮，也可以直接在wxml加class */
.my_button[text="学生登录入口"] {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #ffffff;
  border: 1rpx solid #4facfe;
}

/* 管理端登录入口 - 特定颜色 (深色/橙色系) */
.my_button[text="学校管理员入口"],
.my_button[text="管理端登录入口"] {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); /* 这里用了清新的绿色，或者你可以换成深色 */
  /* 如果想要严肃一点的风格，可以用下面这行深色渐变： */
  /* background: linear-gradient(135deg, #30336b 0%, #1e272e 100%); */
  color: #ffffff;
  border: 1rpx solid #43e97b;
}

/* active: 按钮被按下的状态 */
.my_button:active {
  transform: scale(0.98);  /* 轻微缩小，提供触觉反馈 */
  opacity: 0.9;            /* 稍微变暗 */
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.1);
}