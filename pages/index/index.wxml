
<view class="page">
  <!-- 顶部导航栏 -->
  <view class="navbar">
    <text class="title">今日值日任务</text>
    <view class="notification-bell" bindtap="goNotifications">
      🔔
      <text wx:if="{{unreadCount > 0}}" class="badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </view>

  <view class="container" wx:if="{{!loading}}">
    <!-- 有任务 -->
    <view wx:if="{{hasTask}}">
      <view class="card">
        <view class="label">值日地点</view>
        <view class="value">{{location}}</view>
      </view>
      <view class="card">
        <view class="label">时间段</view>
        <view class="value">{{timeRange}}</view>
      </view>
      <view class="card">
        <view class="label">评价状态</view>
        <view class="value">{{status}}</view>
      </view>
      <view class="card">
        <view class="label">打卡状态</view>
        <view class="value">{{isCheckedIn ? '已打卡':'未打卡'}}</view>
      </view>

      <!-- 没打卡 → 跳转相机页 -->
      <view wx:if="{{!isCheckedIn}}">
        <button class="my_button" type="primary" bindtap="goCamera">开始拍照打卡</button>
      </view>
    </view>      <!-- 关闭 hasTask -->

    <!-- 没有任务 -->
    <view wx:if="{{!hasTask}}">暂无任务</view>
  </view>        <!-- 关闭 container -->

  <!-- 加载中 -->
  <view wx:if="{{loading}}">加载中...</view>
</view>          