<view class="container">
  <view class="header">📋 今日待评价任务</view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:for="{{tasks}}" wx:key="record_id">
    <view class="task-card" bindtap="goEvaluate" data-id="{{item.record_id}}">
      <view class="card-header">
        <text class="class-name">{{item.class_name}}</text>
        <text class="status {{item.status}}">{{item.status}}</text>
      </view>
      <view class="card-body">
        <text class="location">📍 {{item.location}}</text>
        <text class="check-status">
          {{item.has_checked_in ? '✅ 已打卡' : '❌ 未打卡'}}
        </text>
      </view>
    </view>
  </block>

  <view wx:if="{{tasks.length === 0 && !loading}}" class="empty">
    暂无待评价任务
  </view>
</view>


