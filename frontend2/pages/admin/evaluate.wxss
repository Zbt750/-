.container { padding: 20px; }
.header { font-size: 18px; font-weight: bold; margin-bottom: 15px; }
.loading { text-align: center; color: #999; margin-top: 50px; }
.photo-section { margin-bottom: 20px; }
.label { font-size: 14px; color: #666; margin-bottom: 8px; }
.photo { width: 100%; border-radius: 8px; }
.no-photo { padding: 30px; text-align: center; background: #f5f5f5; border-radius: 8px; color: #999; }
.evaluate-section { display: flex; gap: 10px; margin-bottom: 20px; }
.btn-qualified { flex: 1; background: #07c160; color: white; }
.btn-unqualified { flex: 1; background: #e64340; color: white; }
.reason-section { margin-bottom: 20px; }
.reason-input {
  width: 100%;
  height: 100px;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 10px;
  box-sizing: border-box;
  margin-bottom: 10px;
}
.btn-submit { background: #07c160; color: white; }
.already-evaluated {
  text-align: center;
  color: #999;
  padding: 30px;
}