page {
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: #000;
}

/* ====== 相机底部 ====== */
.camera-overlay {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.4));
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}
.shutter-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255,255,255,0.9);
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  bottom: 30rpx;
}
.shutter-inner {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: white;
}

/* ====== 预览页面 ====== */
.preview-container {
  width: 100%;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
}
.preview-image {
  width: 100%;
  height: 100vh;
}

/* 底部操作栏 */
.preview-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 0 60rpx;
  z-index: 200;
}
.action-btn {
  width: 240rpx;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}
.cancel-btn {
  background: rgba(255,255,255,0.2);
  color: white;
  border: 2rpx solid rgba(255,255,255,0.6);
}
.confirm-btn {
  background: #07c160;
  color: white;
}