/* ====== 全局 ====== */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ====== 顶部导航 ====== */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}
.nav-back {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
}
.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.nav-placeholder {
  width: 100rpx;
}

/* ====== 分类标签 ====== */
.tabs {
  display: flex;
  background: white;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 100rpx;
  z-index: 99;
}
.tab {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.2s;
}
.tab.active {
  color: white;
  background: #07c160;
  font-weight: bold;
}
.tab-count {
  font-size: 22rpx;
  color: #999;
  background: #eee;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}
.tab.active .tab-count {
  color: white;
  background: rgba(255,255,255,0.3);
}
.tab.active .tab-count.unread {
  background: #ff4757;
}

/* ====== 加载中 ====== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* ====== 列表滚动 ====== */
.list-scroll {
  height: calc(100vh - 200rpx);
  padding: 20rpx;
}

/* ====== 通知卡片 ====== */
.card {
  display: flex;
  align-items: flex-start;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
  transition: transform 0.1s;
}
.card:active {
  transform: scale(0.98);
}
.card.unread {
  border-left: 6rpx solid #07c160;
  background: linear-gradient(135deg, #f0fff4 0%, #fff 100%);
}
.card.read {
  border-left: 6rpx solid transparent;
  opacity: 0.85;
}

/* 未读红点 */
.unread-dot {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 12rpx;
  height: 12rpx;
  background: #ff4757;
  border-radius: 50%;
}

/* 左侧图标 */
.card-icon {
  width: 60rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}
.icon-dot {
  font-size: 36rpx;
}

/* 中间内容 */
.card-body {
  flex: 1;
  min-width: 0;
}
.card-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.unread-tag {
  font-size: 22rpx;
  color: #ff4757;
  background: #fff0f0;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.card-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.card-time {
  font-size: 24rpx;
  color: #bbb;
}

/* 右侧箭头 */
.card-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #ddd;
  padding-left: 16rpx;
  line-height: 100rpx;
}

/* ====== 加载更多 ====== */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #ccc;
}
.load-more.done {
  color: #ddd;
}

/* ====== 空状态 ====== */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
}