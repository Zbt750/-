<!-- 顶部导航栏 -->
<view class="navbar">
  
  <text class="nav-title">📬 我的通知</text>
  <view class="nav-placeholder"></view>
</view>

<!-- 分类标签 -->
<view class="tabs">
  <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
    全部
    <text class="tab-count">{{allCount}}</text>
  </view>
  <view class="tab {{currentTab === 'unread' ? 'active' : ''}}" bindtap="switchTab" data-tab="unread">
    未读
    <text wx:if="{{unreadCount > 0}}" class="tab-count unread">{{unreadCount}}</text>
  </view>
</view>

<!-- 加载中 -->
<view wx:if="{{loading}}" class="loading-container">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<!-- 通知列表 -->
<scroll-view 
  wx:elif="{{filteredList.length > 0}}"
  class="list-scroll"
  scroll-y
  bindscrolltolower="loadMore"
  refresher-enabled="{{true}}"
  refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onRefresh"
>
  <block wx:for="{{filteredList}}" wx:key="id">
    <view 
      class="card {{item.is_read ? 'read' : 'unread'}}" 
      bindtap="markRead" 
      data-id="{{item.id}}"
    >
      <!-- 未读红色小圆点 -->
      <view wx:if="{{!item.is_read}}" class="unread-dot"></view>

      <!-- 左侧图标区 -->
      <view class="card-icon">
        <text wx:if="{{!item.is_read}}" class="icon-dot">🔴</text>
        <text wx:else class="icon-dot">⚪</text>
      </view>

      <!-- 中间内容区 -->
      <view class="card-body">
        <view class="card-title-row">
          <text class="card-title">{{item.title}}</text>
          <text wx:if="{{!item.is_read}}" class="unread-tag">未读</text>
        </view>
        <view class="card-content">{{item.content}}</view>
        <view class="card-time">{{formatTime(item.created_at)}}</view>
      </view>

      <!-- 右侧箭头 -->
      <view class="card-arrow">›</view>
    </view>
  </block>

  <!-- 加载更多 -->
  <view wx:if="{{hasMore}}" class="load-more">
    <text>加载更多...</text>
  </view>
  <view wx:else class="load-more done">
    <text>— 已显示全部通知 —</text>
  </view>
</scroll-view>

<!-- 空状态 -->
<view wx:elif="{{!loading && filteredList.length === 0}}" class="empty-container">
  <view class="empty-icon">📭</view>
  <text class="empty-text">
    {{currentTab === 'unread' ? '暂无未读通知' : '暂无通知'}}
  </text>
</view>