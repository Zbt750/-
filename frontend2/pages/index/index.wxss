.my_text{
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
}

.label{
  color:#666 ;
  font-size: 14px;
  margin-bottom: 5px;
}
.value{
 font-weight: bold;
 font-size: 16px;
}
.container{
 padding: 20px;
}
.card{
 background: #f5f5f5;
 margin-bottom: 15px;
 padding: 15px;
 border-radius: 8px;
}
.my_button{
 margin-top: 30px;
 color: #f5f5f5;
 background-color: #666666;
}
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  background: #07c160;
  color: white;
}

.title {
  font-size: 18px;
  font-weight: bold;
}

.notification-bell {
  position: relative;
  font-size: 24px;
  padding: 5px;
}

.badge {
  position: absolute;
  top: -5px;
  right: -10px;
  background: red;
  color: white;
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 10px;
  min-width: 18px;
  text-align: center;
}